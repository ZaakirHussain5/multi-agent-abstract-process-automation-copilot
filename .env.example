# mock runs the full product with no keys. Set openai to call an OpenAI-compatible API.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.meta.com/v1
LLM_API_KEY=

# Meta Muse series, routed by role. Rename to whatever the Model API exposes.
MUSE_SPARK_MODEL=muse-spark
MUSE_CODE_MODEL=muse-code
MUSE_IMAGE_MODEL=muse-image

LLM_TIMEOUT_SECONDS=90
DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
